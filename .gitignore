# ==============================================================================
# FarmMate .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example

# Node / Frontend Dependencies & Build Output
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database & Vector Store Files
data/chroma_db/
*.sqlite
*.sqlite3
*.db

# ML Training & Cache Artifacts
catboost_info/
checkpoints/
lightning_logs/
wandb/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS Specific
.DS_Store
Thumbs.db
Desktop.ini

# Agent & Personal Scratch Notes
.github/
notes.txt
scratch/
scratch_*.py

# Logs & Temporary Files
*.log
*.tmp
*.bak
